{
  "name": "@opentag/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --testTimeout=30000",
    "test:agent-runtime:coverage": "vitest run --config vitest.agent-runtime.config.ts",
    "test:e2e:claude-code-agent-runtime": "tsx src/smoke/claude-code-agent-runtime-e2e.ts",
    "test:e2e:codex-agent-runtime": "tsx src/smoke/codex-agent-runtime-e2e.ts",
    "test:e2e:pi-agent-runtime": "tsx src/smoke/pi-agent-runtime-e2e.ts"
  },
  "dependencies": {
    "@opentag/shared": "workspace:*",
    "pino": "^10.3.1",
    "semver": "^7.8.5",
    "ws": "^8.21.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@first-tree-ai/context-tree": "0.1.7",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
