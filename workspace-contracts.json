{
  "schemaVersion": 1,
  "workspaces": {
    "apps/cli": {
      "name": "open-tag",
      "requiresRootExport": true,
      "requiresFiles": true,
      "allowedWorkspaceDependencies": ["@opentag/client", "@opentag/shared"]
    },
    "apps/web": {
      "name": "@opentag/web",
      "requiresRootExport": false,
      "requiresFiles": false,
      "allowedWorkspaceDependencies": ["@opentag/mcp-presets", "@opentag/shared"]
    },
    "packages/client": {
      "name": "@opentag/client",
      "requiresRootExport": true,
      "requiresFiles": true,
      "allowedWorkspaceDependencies": ["@opentag/shared"]
    },
    "packages/mcp-presets": {
      "name": "@opentag/mcp-presets",
      "requiresRootExport": true,
      "requiresFiles": true,
      "allowedWorkspaceDependencies": ["@opentag/shared"]
    },
    "packages/server": {
      "name": "@opentag/server",
      "requiresRootExport": true,
      "requiresFiles": true,
      "allowedWorkspaceDependencies": ["@opentag/mcp-presets", "@opentag/shared", "@opentag/skill-presets"]
    },
    "packages/skill-presets": {
      "name": "@opentag/skill-presets",
      "requiresRootExport": true,
      "requiresFiles": true,
      "allowedWorkspaceDependencies": ["@opentag/shared"]
    },
    "packages/shared": {
      "name": "@opentag/shared",
      "requiresRootExport": true,
      "requiresFiles": true,
      "allowedWorkspaceDependencies": []
    },
    "e2e": {
      "name": "@opentag/e2e",
      "requiresRootExport": false,
      "requiresFiles": false,
      "allowedWorkspaceDependencies": ["@opentag/shared"]
    }
  }
}
