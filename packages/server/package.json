{
  "name": "@opentag/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cloud-billing": {
      "types": "./dist/cloud-billing.d.mts",
      "import": "./dist/cloud-billing.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/app.ts src/cloud-billing.ts src/admin/bootstrap.ts src/admin/bootstrap-cli.ts src/admin/transfer-agent.ts src/admin/transfer-agent-cli.ts src/db/migrate-cli.ts --format esm --dts",
    "bootstrap:admin": "node dist/admin/bootstrap-cli.mjs",
    "transfer:agent": "node dist/admin/transfer-agent-cli.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --exclude 'src/__tests__/integration/**'",
    "test:integration": "vitest run src/__tests__/integration --maxWorkers=2"
  },
  "dependencies": {
    "@autotelic/fastify-opentelemetry": "^0.23.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@first-tree-ai/context-tree": "0.1.16",
    "@google-cloud/error-reporting": "^4.3.0",
    "@larksuiteoapi/node-sdk": "^1.75.0",
    "@opentag/mcp-presets": "workspace:*",
    "@opentag/shared": "workspace:*",
    "@opentag/skill-presets": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@slack/web-api": "^8.2.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.10",
    "croner": "10.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "logfire": "^0.23.0",
    "postgres": "^3.4.9",
    "tar-stream": "3.2.2",
    "undici": "^8.12.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/tar-stream": "^3.1.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.10",
    "graphql": "17.0.2",
    "testcontainers": "^12.1.0",
    "vitest": "^5.0.1"
  }
}
