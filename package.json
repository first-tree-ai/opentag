{
  "name": "opentag-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "biome check . && node scripts/third-party-notices.mjs --check",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "node --test --test-concurrency=1 scripts/__tests__/*.test.mjs && turbo run test --concurrency=2",
    "test:coverage": "pnpm build && vitest run --config vitest.coverage.config.ts --maxWorkers=1",
    "check:node-compat": "pnpm build && pnpm test && node scripts/node-compat-smoke.mjs",
    "notices:write": "node scripts/third-party-notices.mjs --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/helper-string-parser": "8.0.0-rc.2",
      "@babel/helper-validator-identifier": "8.0.0-rc.2",
      "@babel/parser": "8.0.0-rc.2",
      "@babel/types": "8.0.0-rc.2",
      "ast-kit": "3.0.0-beta.1",
      "rollup": "4.59.0",
      "tsdown": "0.22.14"
    }
  }
}
