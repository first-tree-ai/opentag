+function running(pid: number) {
+  try {
+    const state = execFileSync("ps", ["-o", "stat=", "-p", String(pid)], {
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "ignore"],
+    }).trim();
+    return state.length > 0 && !state.startsWith("Z");
+  } catch (error) {
+    if ((error as { status?: number }).status === 1) return false;
+    throw error;
+  }
+}
+
+function stopOwnedGroup(group: number) {
+  try {
+    process.kill(-group, "SIGKILL");
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ESRCH") throw error;
+  }
+}
+
+async function killRunner(peer: NativePeer, target: Lane, groups: number[]) {
+  expect(peer.errors).toEqual([]);
+  expect(peer.entries).toEqual([expect.objectContaining({ phase: "started" })]);
+  const rootEntry = peer.entries?.[0] as { deliveryId?: string; turnId?: string } | undefined;
+  assert(rootEntry?.deliveryId && rootEntry.turnId);
+  const group = peer.nativeGroupPid;
+  assert(group);
+  groups.push(group);
+  const pids = execFileSync("pgrep", ["-g", String(group)], { encoding: "utf8" })
+    .trim()
+    .split(/\s+/)
+    .map(Number);
+  expect(pids.length).toBeGreaterThanOrEqual(2);
+  expect(pids.map(running)).toEqual(pids.map(() => true));
+  const signal = new Promise((resolve) => peer.child.once("exit", (_code, value) => resolve(value)));
+  const killedAt = performance.now();
+  expect(peer.child.kill("SIGKILL")).toBe(true);
+  expect(await signal).toBe("SIGKILL");
+  await peer.exited;
+  await expect.poll(() => pids.map(running), { timeout: 5000 }).toEqual(pids.map(() => false));
+  return {
+    agentId: target.agentId,
+    rootDeliveryId: rootEntry.deliveryId,
+    turnId: rootEntry.turnId,
+    group,
+    pids,
+    journalPhase: "started",
+    observedInputs: 65,
+    automaticallyStopped: true,
+    quiescenceMs: Math.round(performance.now() - killedAt),
+  };
+}
