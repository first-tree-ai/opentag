OPENTAG_HOST=127.0.0.1
OPENTAG_PORT=8000
OPENTAG_SERVER_URL=http://127.0.0.1:8000
OPENTAG_PUBLIC_URL=http://127.0.0.1:8000
OPENTAG_ENV=dev
OPENTAG_DATABASE_URL=postgresql://opentag:opentag@localhost:5432/opentag
OPENTAG_JWT_SECRET=replace-with-at-least-32-random-characters
# Must not repeat OPENTAG_JWT_SECRET; the two rotate independently.
BETTER_AUTH_SECRET=replace-with-a-different-32-random-characters
OPENTAG_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Optional authenticated v2 envelope key ring: a JSON object of stable key ID to canonical base64
# 32-byte key. Keep retired key IDs present until every v2 ciphertext written with them has rotated
# away; OPENTAG_ENCRYPTION_KEY remains the dedicated legacy v1 key and stays required.
# OPENTAG_ENCRYPTION_KEY_RING={"im-2026-09":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
# OPENTAG_ENCRYPTION_ACTIVE_KEY_ID=im-2026-09
# IM credential writes stay on the legacy v1 envelope; set to 2 (requires the ring above) to start
# writing the authenticated v2 envelope. Reads accept both envelopes either way.
# OPENTAG_IM_CREDENTIAL_ENCRYPTION_WRITE_VERSION=1
OPENTAG_AUTO_MIGRATE=true
OPENTAG_LOG_LEVEL=info
# OPENTAG_OTEL_ENDPOINT=https://logfire-us.pydantic.dev/v1/traces
# OPENTAG_OTEL_HEADERS=Authorization=Bearer <write-token>
# OPENTAG_OTEL_ENVIRONMENT=development
# OPENTAG_OTEL_SAMPLE_RATE=1
# Forward relayed Web App and CLI errors to Google Cloud Error Reporting; unset keeps them in the server log only.
# Credentials come from OPENTAG_ERROR_REPORTING_CREDENTIALS_JSON (the key file's JSON; never commit a real one)
# or from Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS or workload identity).
# GOOGLE_CLOUD_PROJECT=
# OPENTAG_ERROR_REPORTING_CREDENTIALS_JSON=
# Reverse proxies trusted to set X-Forwarded-*: true, false, or IPs/CIDRs/loopback/linklocal/uniquelocal.
# OPENTAG_TRUST_PROXY=false
# OPENTAG_DEV_AUTH_BYPASS_ENABLED=true
# OPENTAG_DEV_AUTH_EMAIL=admin@example.com
# OPENTAG_DEV_INTERNAL_TOOLS_ENABLED=true
# OPENTAG_GOOGLE_CLIENT_ID=
# OPENTAG_GOOGLE_CLIENT_SECRET=
# OPENTAG_SLACK_CLIENT_ID=
# OPENTAG_SLACK_CLIENT_SECRET=
# OPENTAG_SLACK_SIGNING_SECRET=
# OPENTAG_SLACK_REDIRECT_URL=http://127.0.0.1:8000/api/v1/im-bindings/slack/oauth/callback
# Deployment-level GitHub App for the Account GitHub integration. All five material values are
# configured together or not at all; the App must issue expiring user access tokens. The private
# key is the App's PEM, base64-encoded or literal with \n escapes. The redirect URL defaults to
# <OPENTAG_PUBLIC_URL>/api/v1/integrations/github/oauth/callback and must stay on the public origin.
# OPENTAG_GITHUB_APP_ID=871235
# OPENTAG_GITHUB_APP_CLIENT_ID=Iv1.replace-me
# OPENTAG_GITHUB_APP_CLIENT_SECRET=replace-me
# OPENTAG_GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTi...base64-PEM...
# OPENTAG_GITHUB_APP_WEBHOOK_SECRET=replace-me
# OPENTAG_GITHUB_OAUTH_REDIRECT_URL=http://127.0.0.1:8000/api/v1/integrations/github/oauth/callback
# Overall Cloud Computer switch, off by default. Enabling it requires the storage prefix and
# Runner version below plus ALL eight Runner coordinates; a missing value fails startup.
# Setup/status reads still never allocate an Instance; see docs/cloud-runner-execution.md.
# Upgrading from an identities-only deployment (identities on without Runner coordinates):
# identities-on now always enables the Runner, so prepare every mandatory coordinate first.
# OPENTAG_CLOUD_IDENTITIES_ENABLED=false
# OPENTAG_CLOUD_STORAGE_BASE=gs://your-sandbox-bucket/prefix
# OPENTAG_CLOUD_RUNNER_VERSION=0.0.5
# The eight mandatory Runner coordinates:
# OPENTAG_CLOUD_RUNNER_IMAGE=us-west1-docker.pkg.dev/your-project/runners/opentag-runner@sha256:<digest>
# OPENTAG_CLOUD_RUNNER_PROJECT=your-project
# OPENTAG_CLOUD_RUNNER_REGION=us-west1
# OPENTAG_CLOUD_RUNNER_SERVICE_ACCOUNT=runner@your-project.iam.gserviceaccount.com
# OPENTAG_CLOUD_RUNNER_BACKEND_ORIGIN=https://api.example.com
# OPENTAG_CLOUD_RUNNER_VPC_NETWORK=your-network
# OPENTAG_CLOUD_RUNNER_VPC_SUBNET=your-subnet
# OPENTAG_CLOUD_RUNNER_EXECUTION_TAG=your-execution-tag
# Model requests can be disabled independently while Runner save/release remains available.
# OPENTAG_CLOUD_MODEL_ENABLED=false
# When the model path is enabled, OPENTAG_CLOUD_MODEL_UPSTREAM_BASE_URL (the Router base,
# including /v1) and OPENTAG_CLOUD_MODEL_MASTER_KEY (the Router LLM credential) are required.
# Model choices come only from that Router's authenticated GET /models — tenant permissions and
# priced registry already applied — via the Server's bounded short-lived catalog; an Agent without
# an explicit model uses the first Router model.
# Retired: OPENTAG_CLOUD_MODEL_ALLOWED_MODELS no longer restricts or supplies Cloud models; it is
# parsed but ignored so a staged environment keeps booting. Remove it after the rollback window.
# Retired: OPENTAG_CLOUD_RUNNER_ENABLED is no longer a switch and NOT a runtime pause toggle; it
# is read only as a migration check. A leftover "true" is tolerated so an older Server rollback
# target still boots. A leftover "false" together with OPENTAG_CLOUD_IDENTITIES_ENABLED=true fails
# startup, because that combination used to pause execution and silently ignoring it would enable
# the paused Runner; a malformed value also fails startup. To keep execution off, set
# OPENTAG_CLOUD_IDENTITIES_ENABLED=false. Remove the retired variable after the rollback window.
# Concurrent physical allocation ceilings; existing resources and cleanup remain permitted at capacity.
# OPENTAG_CLOUD_RUNNER_MAX_INSTANCES_PER_ACCOUNT=3
# OPENTAG_CLOUD_RUNNER_MAX_INSTANCES=20
# Optional S3-compatible object storage for Agent Skill bundles. Configure the five material values
# together or not at all; without them, Skill listing still works and bundle upload/download fails
# with SKILL_STORAGE_UNAVAILABLE. Keep the bucket private. These values match the MinIO service in
# docker-compose.yml; replace them outside local development.
# OPENTAG_SKILL_STORAGE_ENDPOINT=http://127.0.0.1:9000
# OPENTAG_SKILL_STORAGE_REGION=us-east-1
# OPENTAG_SKILL_STORAGE_BUCKET=opentag-skills
# OPENTAG_SKILL_STORAGE_ACCESS_KEY_ID=opentag
# OPENTAG_SKILL_STORAGE_SECRET_ACCESS_KEY=opentag-minio-dev
# PREFIX is normalized (empty slash segments dropped) and used in that form by writes and by the
# collector, which only ever considers keys directly under this exact prefix; deployments may share a
# bucket, including with nested prefixes.
# OPENTAG_SKILL_STORAGE_PREFIX=skills
# OPENTAG_SKILL_STORAGE_FORCE_PATH_STYLE=true
# Orphan-object collection, only meaningful with the storage group above: interval in seconds
# (0 disables) and the minimum object age before it may be collected (floor 300).
# OPENTAG_SKILL_STORAGE_GC_INTERVAL_SECONDS=3600
# OPENTAG_SKILL_STORAGE_GC_GRACE_SECONDS=86400

# Local only: opt into transparent platform proxies; Cloud requires proxy mode.
OPENTAG_RUNTIME_CREDENTIAL_MODE=legacy
