{
  "name": "@opentag/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/app.ts src/admin/bootstrap.ts src/admin/bootstrap-cli.ts src/db/migrate-cli.ts --format esm --dts",
    "bootstrap:admin": "node dist/admin/bootstrap-cli.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --exclude 'src/__tests__/integration/**'",
    "test:integration": "vitest run src/__tests__/integration --maxWorkers=2"
  },
  "dependencies": {
    "@autotelic/fastify-opentelemetry": "^0.23.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@first-tree-ai/context-tree": "0.1.15",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@opentag/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@slack/web-api": "^8.1.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "graphql": "17.0.2",
    "jose": "^6.2.12",
    "logfire": "^0.22.9",
    "postgres": "^3.4.9",
    "tar-stream": "3.2.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.11"
  }
}
