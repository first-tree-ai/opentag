{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "biome.json",
    ".node-version",
    "tsconfig*.json",
    "vitest*.config.{js,ts,mjs,mts}",
    "packages/*/vitest*.config.{js,ts,mjs,mts}"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "OPENTAG_DATABASE_URL",
    "OPENTAG_E2E_*",
    "OPENTAG_SERVICE_MODE",
    "OPENTAG_SERVER_URL",
    "OPENTAG_PORT",
    "PORT",
    "VITEST"
  ],
  "globalPassThroughEnv": [
    "GITHUB_OUTPUT",
    "GITHUB_TOKEN",
    "MAIN_COMMITS",
    "OPENTAG_E2E_ADMIN_DATABASE_URL",
    "OPENTAG_E2E_ARTIFACTS",
    "OPENTAG_E2E_CHROMIUM",
    "OPENTAG_E2E_DATABASE",
    "OPENTAG_E2E_KEEP_DATABASE",
    "OPENTAG_E2E_PLAYWRIGHT_PATH",
    "OPENTAG_E2E_PORT",
    "OPENTAG_E2E_PROVIDER_STUB",
    "OPENTAG_PORTABLE_DOWNLOAD_BASE_URL",
    "OPENTAG_PORTABLE_NODE_CACHE_DIR",
    "RELEASE_TAGS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false
    },
    "e2e": {
      "cache": false
    },
    "test:e2e:claude-code-agent-runtime": {
      "cache": false
    },
    "test:e2e:codex-agent-runtime": {
      "cache": false
    },
    "test:e2e:pi-agent-runtime": {
      "cache": false
    },
    "paraglide": {
      "inputs": ["package.json", "messages/**", "project.inlang/settings.json"],
      "outputs": ["src/paraglide/**"]
    },
    "@opentag/web#build": {
      "dependsOn": ["^build", "paraglide"],
      "outputs": ["dist/**"]
    },
    "@opentag/web#typecheck": {
      "dependsOn": ["^build", "paraglide"]
    },
    "@opentag/web#test": {
      "dependsOn": ["^build", "paraglide"]
    }
  }
}
