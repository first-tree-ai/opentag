{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "GITHUB_OUTPUT",
    "GITHUB_TOKEN",
    "MAIN_COMMITS",
    "OPENTAG_PORTABLE_DOWNLOAD_BASE_URL",
    "OPENTAG_PORTABLE_NODE_CACHE_DIR",
    "RELEASE_TAGS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
